{
    "name": "norialabs/notify",
    "description": "Laravel SDK, mail transport and SMS notification channel for Noria Notify: send transactional email and SMS through one internal service instead of wiring a provider into every product.",
    "type": "library",
    "keywords": [
        "laravel",
        "mail",
        "email",
        "sms",
        "notifications",
        "transactional",
        "ses",
        "onfon",
        "noria"
    ],
    "license": "MIT",
    "homepage": "https://github.com/norialabs/notify",
    "support": {
        "issues": "https://github.com/norialabs/notify/issues",
        "source": "https://github.com/norialabs/notify"
    },
    "authors": [
        {
            "name": "Joseph Gitonga",
            "email": "thekiharani@gmail.com",
            "homepage": "https://github.com/thekiharani"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/mail": "^11.0|^12.0|^13.0",
        "illuminate/notifications": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "symfony/mailer": "^7.0|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.29"
    },
    "autoload": {
        "psr-4": {
            "NoriaLabs\\Notify\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NoriaLabs\\Notify\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress",
        "format": "pint",
        "format:test": "pint --test",
        "quality": [
            "@format:test",
            "@analyse",
            "@test:coverage"
        ],
        "test": "pest",
        "test:coverage": "pest --coverage"
    },
    "extra": {
        "laravel": {
            "providers": [
                "NoriaLabs\\Notify\\Providers\\NotifyServiceProvider"
            ],
            "aliases": {
                "Notify": "NoriaLabs\\Notify\\Facades\\Notify"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
