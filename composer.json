{
    "name": "norialabs/send",
    "description": "Laravel SDK, mail transport and SMS notification channel for Noria Send: send transactional email and SMS through one internal service instead of wiring a provider into every product.",
    "type": "library",
    "keywords": [
        "laravel",
        "mail",
        "email",
        "sms",
        "notifications",
        "transactional",
        "ses",
        "onfon",
        "noria"
    ],
    "license": "MIT",
    "homepage": "https://github.com/norialabs/send",
    "support": {
        "issues": "https://github.com/norialabs/send/issues",
        "source": "https://github.com/norialabs/send"
    },
    "authors": [
        {
            "name": "Joseph Gitonga",
            "email": "thekiharani@gmail.com",
            "homepage": "https://github.com/thekiharani"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/http": "^13.0",
        "illuminate/mail": "^13.0",
        "illuminate/notifications": "^13.0",
        "illuminate/support": "^13.0",
        "symfony/mailer": "^7.4|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32"
    },
    "autoload": {
        "psr-4": {
            "NoriaLabs\\Send\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NoriaLabs\\Send\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress",
        "format": "pint",
        "format:test": "pint --test",
        "quality": [
            "@format:test",
            "@analyse",
            "@test:coverage"
        ],
        "test": "pest",
        "test:coverage": "pest --coverage"
    },
    "extra": {
        "laravel": {
            "providers": [
                "NoriaLabs\\Send\\Providers\\SendServiceProvider"
            ],
            "aliases": {
                "Send": "NoriaLabs\\Send\\Facades\\Send"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
